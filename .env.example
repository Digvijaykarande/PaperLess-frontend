# --- Required for production builds ---
# Base URL of the deployed PaperLess Spring Boot API (include /api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8090/api/v1

# Your public site URL, no trailing slash. Drives canonical URLs, sitemap, robots and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional ---
# Shown on the Contact and Privacy pages
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Must match your backend / Cloudinary plan (free Cloudinary raw uploads are limited to 10 MB)
NEXT_PUBLIC_MAX_FILE_MB=10

# Must match the backend's automatic cleanup
NEXT_PUBLIC_FILE_RETENTION_HOURS=1

# Keep false until the backend auth endpoints exist (this also hides /login and /register)
NEXT_PUBLIC_ENABLE_AUTH=false

# Google Search Console HTML-tag verification token (the content="..." value only)
GOOGLE_SITE_VERIFICATION=
